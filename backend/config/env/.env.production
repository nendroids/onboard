# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ .env: production                                                                                 ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

SECRET_KEY="$(openssl rand -hex 32)"
JWT_SECRET_KEY="$(openssl rand -hex 32)"

DATABASE_URL="postgresql://user:password@db-host:5432/onboard_prod"

REDIS_HOST="redis-prod.internal"
REDIS_PORT="6379"
REDIS_URL="redis://:password@redis-prod.internal:6379/0"
CACHE_REDIS_URL="redis://:password@redis-prod.internal:6379/1"
CELERY_BROKER_URL="redis://:password@redis-prod.internal:6379/2"
CELERY_RESULT_BACKEND="redis://:password@redis-prod.internal:6379/3"

MAIL_SERVER="smtp.sendgrid.net"
MAIL_PORT="587"
MAIL_USE_TLS="true"
MAIL_USERNAME="apikey"
MAIL_PASSWORD="your-sendgrid-api-key"
MAIL_DEFAULT_SENDER="noreply@onboard.example.com"

GCHAT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/.../messages"

FRONTEND_URL="https://onboard.example.com"
BACKEND_URL="https://api.onboard.example.com"